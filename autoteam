#!/usr/bin/env bash
# 根目录入口：只定位固定版本的 autoteam CLI，然后交给它执行。
set -euo pipefail

# 由当前 autoteam 包的构建提交渲染，不使用会移动的 main 分支。
AUTOTEAM_REF=a8fc64ba82827a97970d985699863907ec382960
root=$(cd "$(dirname "$0")" && pwd)

# 本机 skill 只有版本与 AUTOTEAM_REF 一致才用：HOME 下装过别的版本时，CLI、角色指令和
# runbook 会各取各的版本。自举仓库（skill 就是本仓库的 skills/autoteam）不受影响。
for skill in \
  "$root/.claude/skills/autoteam" \
  "$root/.agents/skills/autoteam" \
  "$root/.codex/skills/autoteam" \
  "$HOME/.claude/skills/autoteam" \
  "$HOME/.agents/skills/autoteam" \
  "$HOME/.codex/skills/autoteam"; do
  [ -f "$skill/bin/autoteam" ] || continue
  if [ "$(cd -P "$skill" && pwd)" = "$(cd -P "$root" && pwd)/skills/autoteam" ]; then
    exec bash "$skill/bin/autoteam" "$@"
  fi
  skill_ref=$(cat "$skill/source-ref" 2>/dev/null || true)
  if [ "$skill_ref" = "$AUTOTEAM_REF" ]; then
    exec bash "$skill/bin/autoteam" "$@"
  fi
  echo "autoteam：忽略 $skill（版本 ${skill_ref:-未知}，入口固定 $AUTOTEAM_REF），改用固定版本" >&2
done

cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/autoteam/cli
cache=$cache_root/$AUTOTEAM_REF
cli=$cache/skills/autoteam/bin/autoteam
if [ ! -f "$cli" ]; then
  mkdir -p "$cache_root"
  tmp=$(mktemp -d "$cache_root/.download.XXXXXX")
  if ! curl -fsSL "https://codeload.github.com/autoteam-ai/autoteam/tar.gz/$AUTOTEAM_REF" |
    tar -xz -C "$tmp" --strip-components=1; then
    rm -rf "$tmp"
    echo "下载 autoteam $AUTOTEAM_REF 失败；检查网络后重试 bash ./autoteam status --check" >&2
    exit 1
  fi
  if [ ! -f "$tmp/skills/autoteam/bin/autoteam" ]; then
    rm -rf "$tmp"
    echo "下载的 autoteam $AUTOTEAM_REF 缺少 CLI" >&2
    exit 1
  fi
  # symlink 的建立是原子的；并发下载者只有一个赢，其他清理自己的完整解压目录。
  if ! ln -s "$tmp" "$cache" 2>/dev/null; then
    rm -rf "$tmp"
  fi
fi
exec bash "$cli" "$@"
