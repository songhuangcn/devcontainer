# IMAGE_NAME=songhuangcn/devcontainer
# IMAGE_TAG=latest

# OPENCODE_PORT=4096

# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-token

# Multica daemon identity and concurrency (credentials are entered interactively
# and persisted in ./data/.multica; never place a PAT in this file).
# MULTICA_AGENT_RUNTIME_NAME=Devcontainer
# MULTICA_DAEMON_DEVICE_NAME=devcontainer
# MULTICA_DAEMON_MAX_CONCURRENT_TASKS=4
