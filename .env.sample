# IMAGE_NAME=songhuangcn/devcontainer
# IMAGE_TAG=latest

# OPENCODE_PORT=4096

# MULTICA_TOKEN=mul_replace-with-your-personal-access-token

# docker-compose.yml 默认复用当前 devcontainer-local 的 Multica runtime 身份。
# device name 不设置时跟随 docker-compose.yml 里固定的容器 hostname
# （devcontainer-local）。只有部署完全独立的另一套本地实例时，才需要覆盖成新
# 的 UUID。
# MULTICA_DAEMON_ID=019fffb2-a6d0-7045-8ff5-9b73fe675dd1
